RewriteEngine On
RewriteBase /

# 301 ze starych adresów na nowe
RewriteRule ^lumen/people/mateuszformicki/matforemport\.html$ /people/formmantcse [R=301,L,NC]
RewriteRule ^lumen/people/mateuszformicki/blog/blog\.html$ /people/formmantcse/blog [R=301,L,NC]
RewriteRule ^lumen/people/mateuszformicki/eportfolio/portfolio\.html$ /people/formmantcse/portfolio [R=301,L,NC]
RewriteRule ^hyperclockhtml/hyperclock\.html$ /hyperclock [R=301,L,NC]

# maskowanie nowych adresów na rzeczywiste pliki
RewriteRule ^people/formmantcse/?$ /lumen/people/mateuszformicki/matforemport.html [L,NC]
RewriteRule ^people/formmantcse/blog/?$ /lumen/people/mateuszformicki/blog/blog.html [L,NC]
RewriteRule ^people/formmantcse/artefakty/?$ /lumen/people/mateuszformicki/blog/artefakty-samotnosci.html [L,NC]
RewriteRule ^people/formmantcse/portfolio/?$ /lumen/people/mateuszformicki/eportfolio/portfolio.html [L,NC]
RewriteRule ^hyperclock/?$ /hyperclockhtml/hyperclock.html [L,NC]
,NC]